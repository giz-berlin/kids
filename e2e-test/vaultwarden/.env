# WARNING: Changing many of these values requires a fresh setup of the test system.
# Run teardown.sh, then setup.sh again.

CERTIFICATE_VALIDITY=365

KEYCLOAK_CONTAINER_NAME="kids-e2e-keycloak"
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_REALM="giz"

# Any Vaultwarden-compatible server image works, e.g. docker.io/vaultwarden/server:<tag> (see README.md)
VAULTWARDEN_IMAGE="docker.io/timshel/oidcwarden:v2026.9.0-3"
VAULTWARDEN_CONTAINER_NAME="vaultwarden"
VAULTWARDEN_TLS_PORT=8000
VAULTWARDEN_ADMIN_TOKEN="super_secure_admin_token"
# Account and organization contained in seed/db.sqlite3, which is copied to vw_data/ on first setup.
VAULTWARDEN_SYNCER_EMAIL="keycloak_identity_syncer@giz.berlin"
VAULTWARDEN_SYNCER_MASTER_PASSWORD="super_secret_master_password"
VAULTWARDEN_USER_CLIENT_ID="user.21f67235-9dae-4cba-9092-83432916e02f"
VAULTWARDEN_USER_CLIENT_SECRET="T7gmxSHXutBFwM4mQ5A6otJGfnREMf"
VAULTWARDEN_ORG_ID="c5946fe8-6980-480d-a75e-bb9b729ce883"
VAULTWARDEN_ORG_CLIENT_ID="organization.c5946fe8-6980-480d-a75e-bb9b729ce883"
VAULTWARDEN_ORG_CLIENT_SECRET="iMV92vKfIIz7RB4QcnmlXbtxj6CZme"

PODMAN_SERVICE_HOSTNAME="host.docker.internal"
