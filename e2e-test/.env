# WARNING: Changing many of these values requires a fresh setup of the test system.
# Run teardown_synapse_e2e.sh, then setup_synapse_e2e.sh again.

KIDS_CA_NAME="kids_local_ca"
CERTIFICATE_VALIDITY=365
KEYCLOAK_CONTAINER_NAME="kids-e2e-keycloak"
SYNAPSE_CONTAINER_NAME="kids-e2e-synapse"
SYNAPSE_PORT=8048
SYNAPSE_TLS_PORT=8448
SYNAPSE_ADMIN_CONTAINER_NAME="kids-e2e-synapse-admin"

PODMAN_SERVICE_HOSTNAME="host.docker.internal"
